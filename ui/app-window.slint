import { Theme, SysMetrics, ServiceMetrics, HudAlert, GithubRepo, GithubEvent } from "theme.slint";
import { OverviewScreen }   from "overview.slint";
import { GithubScreen }     from "github.slint";
import { SystemInfoScreen } from "system-info.slint";
import { HealthScreen }     from "health-screen.slint";
import { AlertsScreen }     from "alerts.slint";

export component AppWindow inherits Window {
    title: "SpaceLab-1 Status Console";
    no-frame: true;
    preferred-width: 720px;
    preferred-height: 720px;
    background: Theme.bg;

    // ── Screen data ───────────────────────────────────────────────────
    in property     <SysMetrics>     metrics;
    in property     <string>         clock-str;
    in property     <bool>           local-network-reachable;

    // One entry per Beszel system the hub reports, ordered/filtered per config.
    in property     <[ServiceMetrics]> systems;
    // Worst stoplight level across all systems, computed Rust-side (Slint can't
    // fold a model to a max).
    in property     <int>            systems-worst-level;

    in property     <[HudAlert]>     alerts;
    in property     <int>            alert-count;
    in property     <int>            alert-worst-severity;
    in property     <bool>           alerts-reachable;

    in property     <[GithubRepo]>   github-repos;
    in property     <[GithubEvent]>  github-events;
    in property     <int>            github-level;
    in property     <string>         github-status;
    in property     <int>            github-pr-count;
    in property     <int>            github-issue-count;
    in property     <bool>           github-configured;
    in property     <bool>           github-reachable;

    // ── Overall system status (single source of truth for every header) ─
    property <float> pi-worst:
        Math.max(Math.max(metrics.cpu-pct, metrics.temp-pct),
                 Math.max(metrics.ram-pct, metrics.disk-pct));
    property <int> pi-level: pi-worst > 0.85 ? 2 : (pi-worst > 0.70 ? 1 : 0);

    property <int> alerts-rollup-level:
        alert-count == 0 ? 0 : alert-worst-severity;

    property <int> overall-level:
        Math.max(Math.max(pi-level, systems-worst-level),
                 Math.max(alerts-rollup-level, github-level));
    property <color> overall-color:
        overall-level == 2 ? Theme.danger
        : (overall-level == 1 ? Theme.warn : Theme.accent);

    // ── Swipe state ───────────────────────────────────────────────────
    // Fixed pages bracket a dynamic middle block, one screen per Beszel system:
    //   0 Overview · 1 GitHub · [2 .. 2+N) systems · (2+N) HUD · (3+N) Alerts
    // where N = systems.length.
    property        <int>    page-count:     4 + root.systems.length;
    in-out property <int>    current-page:   0;
    property        <int>    committed-page: 0;
    property        <length> drag-offset:    0px;
    property        <bool>   is-dragging:    false;

    // ── Screens container ────────────────────────────────────────────
    screens-rect := Rectangle {
        y: 0;
        width: root.page-count * root.width;
        height: root.height;

        OverviewScreen {
            x: 0 * root.width;
            width: root.width;
            height: parent.height;
            metrics:              root.metrics;
            systems:              root.systems;
            alerts:               root.alerts;
            alert-count:          root.alert-count;
            alert-worst-severity: root.alert-worst-severity;
            clock-str:            root.clock-str;
            overall-color:        root.overall-color;
            github-level:         root.github-level;
            github-pr-count:      root.github-pr-count;
            github-issue-count:   root.github-issue-count;
            show-back:            true;
            show-forward:         true;
        }

        GithubScreen {
            x: 1 * root.width;
            width: root.width;
            height: parent.height;
            repos:              root.github-repos;
            events:             root.github-events;
            github-level:       root.github-level;
            github-status:      root.github-status;
            github-pr-count:    root.github-pr-count;
            github-issue-count: root.github-issue-count;
            configured:         root.github-configured;
            reachable:          root.github-reachable;
            show-back:          true;
            show-forward:       true;
        }

        // Dynamic middle block: one HealthScreen per Beszel system.
        for system[idx] in root.systems : HealthScreen {
            x: (2 + idx) * root.width;
            width: root.width;
            height: parent.height;
            metrics:      system;
            title:        system.hostname;
            show-back:    true;
            show-forward: true;
        }

        SystemInfoScreen {
            x: (2 + root.systems.length) * root.width;
            width: root.width;
            height: parent.height;
            metrics:           root.metrics;
            network-reachable: root.local-network-reachable;
            show-back:         true;
            show-forward:      true;
        }

        AlertsScreen {
            x: (3 + root.systems.length) * root.width;
            width: root.width;
            height: parent.height;
            alerts:               root.alerts;
            alert-count:          root.alert-count;
            alert-worst-severity: root.alert-worst-severity;
            alerts-reachable:     root.alerts-reachable;
            show-back:            true;
            show-forward:         true;
        }

        states [
            dragging when root.is-dragging: {
                x: -(root.committed-page * root.width) + root.drag-offset;
            }
            snapped when !root.is-dragging: {
                x: -(root.current-page * root.width);
                in {
                    animate x { duration: 300ms; easing: ease-out; }
                }
            }
        ]
    }

    // ── Touch / swipe overlay ─────────────────────────────────────────
    TouchArea {
        width: root.width;
        height: root.height;

        property <length> press-x;
        property <int>    max-page: root.page-count - 1;

        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                press-x = self.mouse-x;
                root.committed-page = root.current-page;
                root.drag-offset    = 0px;
                root.is-dragging    = true;
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                let delta     = self.mouse-x - press-x;
                let abs-delta = delta < 0px ? -delta : delta;

                if abs-delta < 20px {
                    if root.current-page == 0 {
                        // Overview: header edge-tap or card-tap navigation
                        // Layout constants mirror overview.slint (header 84px + 1px border,
                        // inner padding 10px, row gap 7px, three equal-height rows).
                        let header = 85px;
                        let pad    = 10px;
                        let gap    = 7px;
                        let rowh   = (root.height - header - 2 * pad - 2 * gap) / 3;
                        let r1-bot = header + pad + rowh;
                        let r2-bot = r1-bot + gap + rowh;
                        // Fixed screens sit after the dynamic system block.
                        let local-page  = 2 + root.systems.length;
                        let alerts-page = 3 + root.systems.length;

                        if self.mouse-y < header {
                            if self.mouse-x > root.width - 80px {
                                root.current-page = 1;
                            }
                        } else if self.mouse-y < r1-bot {
                            // Row 1: LOCAL | system slot 0 (page 2). With no
                            // systems, LOCAL spans the row.
                            if root.systems.length > 0 {
                                root.current-page = self.mouse-x < root.width / 2 ? local-page : 2;
                            } else {
                                root.current-page = local-page;
                            }
                        } else if self.mouse-y < r2-bot {
                            // Row 2: [slot1 (3)][slot2 (4)][GITHUB (1)] — GITHUB
                            // always last; slot tiles appear as systems exist, so
                            // the tap split tracks the visible column count.
                            if root.systems.length > 2 {
                                root.current-page = self.mouse-x < root.width / 3 ? 3
                                                  : (self.mouse-x < 2 * root.width / 3 ? 4 : 1);
                            } else if root.systems.length > 1 {
                                root.current-page = self.mouse-x < root.width / 2 ? 3 : 1;
                            } else {
                                root.current-page = 1;
                            }
                        } else {
                            root.current-page = alerts-page;
                        }
                    } else {
                        if self.mouse-x < 80px {
                            root.current-page = root.current-page > 0 ? root.current-page - 1 : max-page;
                        } else if self.mouse-x > root.width - 80px {
                            root.current-page = root.current-page < max-page ? root.current-page + 1 : 0;
                        }
                    }
                } else if delta < -60px {
                    root.current-page = root.current-page < max-page ? root.current-page + 1 : 0;
                } else if delta > 60px {
                    root.current-page = root.current-page > 0 ? root.current-page - 1 : max-page;
                }
                root.is-dragging = false;
            }
        }

        moved => {
            if root.is-dragging {
                let raw = self.mouse-x - press-x;
                if root.committed-page == 0 && raw > 0px {
                    root.drag-offset = raw * 0.3;
                } else if root.committed-page == max-page && raw < 0px {
                    root.drag-offset = raw * 0.3;
                } else {
                    root.drag-offset = raw;
                }
            }
        }
    }
}
