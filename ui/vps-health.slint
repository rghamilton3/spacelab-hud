import { Theme, ServiceMetrics } from "theme.slint";
import { MetricCard, MetricBarCard } from "system-info.slint";

export component VpsHealthScreen {
    in property <ServiceMetrics> metrics;
    in property <bool>           show-back:    false;
    in property <bool>           show-forward: false;

    property <float> worst:
        Math.max(Math.max(Math.max(metrics.cpu-pct, metrics.temp-pct), metrics.ram-pct),
                 metrics.disk-pct);
    property <int> level:
        !metrics.reachable ? 2
        : (worst > 0.85 ? 2 : (worst > 0.70 ? 1 : 0));
    property <color> status-color:
        level == 2 ? Theme.danger : (level == 1 ? Theme.warn : Theme.accent);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ── Header ──────────────────────────────────────────────────
        Rectangle {
            height: 84px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 21px;
                padding-right: 21px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "‹";
                        color: Theme.text-label;
                        font-size: 42px;
                        vertical-alignment: center;
                        opacity: root.show-back ? 0.8 : 0.0;
                        animate opacity { duration: 200ms; }
                    }
                    HorizontalLayout {
                        spacing: 0px;
                        Text {
                            text: "SPACELAB-1 // VPS";
                            color: status-color;
                            font-size: 22px;
                            letter-spacing: 3px;
                            vertical-alignment: center;
                            animate color { duration: 500ms; }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: root.metrics.reachable ? Theme.success : Theme.danger;
                            animate background { duration: 400ms; }
                        }
                    }
                    Text {
                        text: root.metrics.reachable ? "ONLINE" : "OFFLINE";
                        color: root.metrics.reachable ? Theme.text-label : Theme.danger;
                        font-size: 24px;
                        letter-spacing: 3px;
                        vertical-alignment: center;
                        animate color { duration: 400ms; }
                    }
                    Text {
                        text: "›";
                        color: Theme.text-label;
                        font-size: 42px;
                        vertical-alignment: center;
                        opacity: root.show-forward ? 0.8 : 0.0;
                        animate opacity { duration: 200ms; }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ── stacked metric rows (matches HUD) ───────────────────────
        VerticalLayout {
            padding: 10px;
            spacing: 7px;

            MetricCard { label: "SYSTEM"; value: root.metrics.hostname; }
            HorizontalLayout {
                spacing: 7px;
                MetricCard { label: "UPTIME";   value: root.metrics.uptime; }
                MetricCard { label: "LOAD AVG"; value: root.metrics.load-avg; }
            }
            HorizontalLayout {
                spacing: 7px;
                MetricBarCard {
                    label:     "CPU USAGE";
                    value:     root.metrics.cpu-usage;
                    pct:       root.metrics.cpu-pct;
                    warn-at:   0.65;
                    danger-at: 0.85;
                }
                MetricBarCard {
                    label:     "CPU TEMP";
                    value:     root.metrics.cpu-temp;
                    pct:       root.metrics.temp-pct;
                    warn-at:   0.75;
                    danger-at: 0.88;
                }
            }
            HorizontalLayout {
                spacing: 7px;
                MetricBarCard {
                    label:     "MEMORY";
                    value:     root.metrics.ram;
                    pct:       root.metrics.ram-pct;
                    warn-at:   0.75;
                    danger-at: 0.90;
                }
                MetricBarCard {
                    label:     "DISK /";
                    value:     root.metrics.disk;
                    pct:       root.metrics.disk-pct;
                    warn-at:   0.80;
                    danger-at: 0.92;
                }
            }
        }
    }
}
