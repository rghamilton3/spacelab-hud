import { Theme, SysMetrics } from "theme.slint";

// Text-only card: hostname, IP, uptime, load avg
export component MetricCard {
    in property <string> label;
    in property <string> value;

    Rectangle {
        background: Theme.surface;
        border-radius: 6px;

        VerticalLayout {
            padding: 16px;
            spacing: 6px;
            alignment: center;

            Text {
                text: root.label;
                color: Theme.text-label;
                font-size: 11px;
                letter-spacing: 2px;
            }
            Text {
                text: root.value;
                color: Theme.text-primary;
                font-size: 20px;
                font-family: "monospace";
            }
        }
    }
}

// Bar card: CPU, temp, RAM, disk — colored left-accent + progress bar
export component MetricBarCard {
    in property <string> label;
    in property <string> value;
    in property <float>  pct;
    in property <float>  warn-at:   0.65;
    in property <float>  danger-at: 0.85;

    property <color> bar-color: root.pct > root.danger-at ? Theme.danger
                               : (root.pct > root.warn-at  ? Theme.warn : Theme.accent);

    Rectangle {
        background: Theme.surface;
        border-radius: 6px;
        clip: true;

        HorizontalLayout {
            spacing: 0px;

            // Accent left-border that shifts color with threshold
            Rectangle {
                width: 3px;
                background: bar-color;
                animate background { duration: 600ms; easing: ease-in-out; }
            }

            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                alignment: center;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: root.label;
                        color: Theme.text-label;
                        font-size: 11px;
                        letter-spacing: 2px;
                    }
                    Text {
                        text: root.value;
                        color: bar-color;
                        font-size: 20px;
                        font-family: "monospace";
                        animate color { duration: 600ms; easing: ease-in-out; }
                    }
                }

                // Track
                Rectangle {
                    height: 5px;
                    background: Theme.text-dim;
                    border-radius: 3px;

                    // Fill
                    Rectangle {
                        x: 0;
                        width: parent.width * root.pct;
                        height: parent.height;
                        background: bar-color;
                        border-radius: 3px;
                        animate width      { duration: 800ms; easing: ease-in-out; }
                        animate background { duration: 600ms; easing: ease-in-out; }
                    }
                }
            }
        }
    }
}

export component SystemInfoScreen {
    in property <SysMetrics> metrics;
    in property <string>     clock-str;
    in property <bool>       heartbeat;
    in property <bool>       show-back:    false;
    in property <bool>       show-forward: false;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ── Header ──────────────────────────────────────────────────
        Rectangle {
            height: 56px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "‹";
                        color: Theme.text-label;
                        font-size: 28px;
                        vertical-alignment: center;
                        opacity: root.show-back ? 0.8 : 0.0;
                        animate opacity { duration: 200ms; }
                    }
                    Text {
                        text: "SPACELAB-1 STATUS CONSOLE";
                        color: Theme.accent;
                        font-size: 17px;
                        letter-spacing: 3px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.clock-str;
                        color: Theme.text-primary;
                        font-size: 18px;
                        font-family: "monospace";
                        vertical-alignment: center;
                    }
                    Text {
                        text: "›";
                        color: Theme.text-label;
                        font-size: 28px;
                        vertical-alignment: center;
                        opacity: root.show-forward ? 0.8 : 0.0;
                        animate opacity { duration: 200ms; }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ── Metric grid ─────────────────────────────────────────────
        GridLayout {
            padding: 10px;
            spacing: 7px;

            Row {
                MetricCard { label: "HOSTNAME";   value: root.metrics.hostname; }
                MetricCard { label: "IP ADDRESS"; value: root.metrics.ip-addr; }
            }
            Row {
                MetricCard { label: "UPTIME";   value: root.metrics.uptime; }
                MetricCard { label: "LOAD AVG"; value: root.metrics.load-avg; }
            }
            Row {
                MetricBarCard {
                    label:      "CPU USAGE";
                    value:      root.metrics.cpu-usage;
                    pct:        root.metrics.cpu-pct;
                    warn-at:    0.65;
                    danger-at:  0.85;
                }
                MetricBarCard {
                    label:      "CPU TEMP";
                    value:      root.metrics.cpu-temp;
                    pct:        root.metrics.temp-pct;
                    warn-at:    0.75;
                    danger-at:  0.88;
                }
            }
            Row {
                MetricBarCard {
                    label:      "MEMORY";
                    value:      root.metrics.ram;
                    pct:        root.metrics.ram-pct;
                    warn-at:    0.75;
                    danger-at:  0.90;
                }
                MetricBarCard {
                    label:      "DISK /";
                    value:      root.metrics.disk;
                    pct:        root.metrics.disk-pct;
                    warn-at:    0.80;
                    danger-at:  0.92;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ── Footer: network + status ─────────────────────────────────
        Rectangle {
            height: 42px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                Text {
                    text: "↓  " + root.metrics.net-rx;
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-family: "monospace";
                    vertical-alignment: center;
                }

                Text {
                    text: "↑  " + root.metrics.net-tx;
                    color: Theme.text-dim;
                    font-size: 14px;
                    font-family: "monospace";
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.heartbeat ? Theme.accent : #003050;
                            animate background { duration: 700ms; easing: ease-in-out; }
                        }
                    }

                    Text {
                        text: "ONLINE";
                        color: Theme.text-label;
                        font-size: 11px;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
