import { Theme, SysMetrics } from "theme.slint";

component MetricCard {
    in property <string> label;
    in property <string> value;

    Rectangle {
        background: Theme.surface;
        border-radius: 6px;

        VerticalLayout {
            padding: 16px;
            spacing: 6px;
            alignment: center;

            Text {
                text: root.label;
                color: Theme.text-label;
                font-size: 13px;
                letter-spacing: 2px;
            }

            Text {
                text: root.value;
                color: Theme.text-primary;
                font-size: 24px;
                font-family: "monospace";
            }
        }
    }
}

export component SystemInfoScreen {
    in property <SysMetrics> metrics;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Header
        Rectangle {
            height: 72px;
            background: Theme.surface;

            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    alignment: space-between;

                    Text {
                        text: "SPACELAB-1 STATUS CONSOLE";
                        color: Theme.accent;
                        font-size: 20px;
                        letter-spacing: 4px;
                    }

                    Text {
                        text: "SYS INFO";
                        color: Theme.text-label;
                        font-size: 13px;
                        letter-spacing: 3px;
                    }
                }
            }
        }

        // Separator
        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        // Metric grid — adding a new metric: add a Row here and a field to SysMetrics in theme.slint
        GridLayout {
            padding: 12px;
            spacing: 8px;

            Row {
                MetricCard { label: "HOSTNAME";   value: root.metrics.hostname; }
                MetricCard { label: "IP ADDRESS"; value: root.metrics.ip-addr; }
            }
            Row {
                MetricCard { label: "UPTIME";   value: root.metrics.uptime; }
                MetricCard { label: "LOAD AVG"; value: root.metrics.load-avg; }
            }
            Row {
                MetricCard { label: "CPU USAGE"; value: root.metrics.cpu-usage; }
                MetricCard { label: "CPU TEMP";  value: root.metrics.cpu-temp; }
            }
            Row {
                MetricCard { label: "MEMORY"; value: root.metrics.ram; }
                MetricCard { label: "DISK /"; value: root.metrics.disk; }
            }
        }
    }
}
