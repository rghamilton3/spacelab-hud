import { Theme, SysMetrics } from "theme.slint";

// Text-only card: hostname, IP, uptime, load avg
export component MetricCard {
    in property <string> label;
    in property <string> value;

    Rectangle {
        background: Theme.surface;
        border-radius: 6px;

        VerticalLayout {
            padding: 16px;
            spacing: 6px;
            alignment: center;

            Text {
                text: root.label;
                color: Theme.text-label;
                font-size: 16px;
                letter-spacing: 2px;
            }
            Text {
                text: root.value;
                color: Theme.text-primary;
                font-size: 20px;
                font-family: "monospace";
            }
        }
    }
}

// Bar card: CPU, temp, RAM, disk — colored left-accent + progress bar
export component MetricBarCard {
    in property <string> label;
    in property <string> value;
    in property <float>  pct;
    in property <float>  warn-at:   0.65;
    in property <float>  danger-at: 0.85;

    property <color> bar-color: root.pct > root.danger-at ? Theme.danger
                               : (root.pct > root.warn-at  ? Theme.warn : Theme.accent);

    Rectangle {
        background: Theme.surface;
        border-radius: 6px;
        clip: true;

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: 3px;
                background: bar-color;
                animate background { duration: 600ms; easing: ease-in-out; }
            }

            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                alignment: center;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: root.label;
                        color: Theme.text-label;
                        font-size: 16px;
                        letter-spacing: 2px;
                    }
                    Text {
                        text: root.value;
                        color: bar-color;
                        font-size: 20px;
                        font-family: "monospace";
                        animate color { duration: 600ms; easing: ease-in-out; }
                    }
                }

                Rectangle {
                    height: 5px;
                    background: Theme.text-dim;
                    border-radius: 3px;

                    Rectangle {
                        x: 0;
                        width: parent.width * root.pct;
                        height: parent.height;
                        background: bar-color;
                        border-radius: 3px;
                        animate width      { duration: 800ms; easing: ease-in-out; }
                        animate background { duration: 600ms; easing: ease-in-out; }
                    }
                }
            }
        }
    }
}

export component SystemInfoScreen {
    in property <SysMetrics> metrics;
    in property <bool>       network-reachable;
    in property <bool>       show-back:    false;
    in property <bool>       show-forward: false;

    property <float> pi-worst:
        Math.max(Math.max(metrics.cpu-pct, metrics.temp-pct),
                 Math.max(metrics.ram-pct, metrics.disk-pct));
    property <int> level: pi-worst > 0.85 ? 2 : (pi-worst > 0.70 ? 1 : 0);
    property <color> status-color:
        level == 2 ? Theme.danger : (level == 1 ? Theme.warn : Theme.accent);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ── Header ──────────────────────────────────────────────────
        Rectangle {
            height: 84px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 21px;
                padding-right: 21px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "‹";
                        color: Theme.text-label;
                        font-size: 42px;
                        vertical-alignment: center;
                        opacity: root.show-back ? 0.8 : 0.0;
                        animate opacity { duration: 200ms; }
                    }
                    HorizontalLayout {
                        spacing: 0px;
                        Text {
                            text: "SPACELAB-1 // HUD";
                            color: status-color;
                            font-size: 22px;
                            letter-spacing: 3px;
                            vertical-alignment: center;
                            animate color { duration: 500ms; }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: root.network-reachable ? Theme.success : Theme.danger;
                            animate background { duration: 400ms; }
                        }
                    }
                    Text {
                        text: root.network-reachable ? "ONLINE" : "OFFLINE";
                        color: root.network-reachable ? Theme.text-label : Theme.danger;
                        font-size: 24px;
                        letter-spacing: 3px;
                        vertical-alignment: center;
                        animate color { duration: 400ms; }
                    }
                    Text {
                        text: "›";
                        color: Theme.text-label;
                        font-size: 42px;
                        vertical-alignment: center;
                        opacity: root.show-forward ? 0.8 : 0.0;
                        animate opacity { duration: 200ms; }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ── Metric grid (equal cols via GridLayout) ──────────────────
        GridLayout {
            padding: 10px;
            spacing: 7px;

            Row {
                MetricCard { label: "HOSTNAME";   value: root.metrics.hostname; }
                MetricCard { label: "IP ADDRESS"; value: root.metrics.ip-addr; }
            }
            Row {
                MetricCard { label: "UPTIME";   value: root.metrics.uptime; }
                MetricCard { label: "LOAD AVG"; value: root.metrics.load-avg; }
            }
            Row {
                MetricBarCard {
                    label:      "CPU USAGE";
                    value:      root.metrics.cpu-usage;
                    pct:        root.metrics.cpu-pct;
                    warn-at:    0.65;
                    danger-at:  0.85;
                }
                MetricBarCard {
                    label:      "CPU TEMP";
                    value:      root.metrics.cpu-temp;
                    pct:        root.metrics.temp-pct;
                    warn-at:    0.75;
                    danger-at:  0.88;
                }
            }
            Row {
                MetricBarCard {
                    label:      "MEMORY";
                    value:      root.metrics.ram;
                    pct:        root.metrics.ram-pct;
                    warn-at:    0.75;
                    danger-at:  0.90;
                }
                MetricBarCard {
                    label:      "DISK /";
                    value:      root.metrics.disk;
                    pct:        root.metrics.disk-pct;
                    warn-at:    0.80;
                    danger-at:  0.92;
                }
            }
        }
    }
}
