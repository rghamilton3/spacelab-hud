import { Theme, ServiceMetrics } from "theme.slint";
import { MetricCard, MetricBarCard } from "system-info.slint";

export component NasHealthScreen {
    in property <ServiceMetrics> metrics;
    in property <bool>           show-back:    false;
    in property <bool>           show-forward: false;

    property <float> worst:
        Math.max(Math.max(Math.max(metrics.cpu-pct, metrics.temp-pct), metrics.ram-pct),
                 metrics.disk-pct);
    property <int> level:
        !metrics.reachable ? 2
        : (worst > 0.85 ? 2 : (worst > 0.70 ? 1 : 0));
    property <color> status-color:
        level == 2 ? Theme.danger : (level == 1 ? Theme.warn : Theme.accent);
    property <string> status-text:
        level == 0 ? "NOMINAL" : (level == 2 ? "CRIT" : "WARN");

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 56px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "‹";
                        color: Theme.text-label;
                        font-size: 28px;
                        vertical-alignment: center;
                        opacity: root.show-back ? 0.8 : 0.0;
                        animate opacity { duration: 200ms; }
                    }
                    HorizontalLayout {
                        spacing: 0px;
                        Text {
                            text: "SPACELAB-1 // NAS // ";
                            color: Theme.accent;
                            font-size: 17px;
                            letter-spacing: 3px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: status-text;
                            color: status-color;
                            font-size: 17px;
                            letter-spacing: 3px;
                            vertical-alignment: center;
                            animate color { duration: 500ms; }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.metrics.reachable ? Theme.success : Theme.danger;
                            animate background { duration: 400ms; }
                        }
                    }
                    Text {
                        text: root.metrics.reachable ? "ONLINE" : "OFFLINE";
                        color: root.metrics.reachable ? Theme.text-label : Theme.danger;
                        font-size: 11px;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                        animate color { duration: 400ms; }
                    }
                    Text {
                        text: "›";
                        color: Theme.text-label;
                        font-size: 28px;
                        vertical-alignment: center;
                        opacity: root.show-forward ? 0.8 : 0.0;
                        animate opacity { duration: 200ms; }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        GridLayout {
            padding: 10px;
            spacing: 7px;

            Row {
                MetricCard { label: "HOSTNAME";   value: root.metrics.hostname; }
                MetricCard { label: "IP ADDRESS"; value: root.metrics.ip-addr; }
            }
            Row {
                MetricCard { label: "UPTIME";   value: root.metrics.uptime; }
                MetricCard { label: "LOAD AVG"; value: root.metrics.load-avg; }
            }
            Row {
                MetricBarCard {
                    label:     "CPU USAGE";
                    value:     root.metrics.cpu-usage;
                    pct:       root.metrics.cpu-pct;
                    warn-at:   0.65;
                    danger-at: 0.85;
                }
                MetricBarCard {
                    label:     "CPU TEMP";
                    value:     root.metrics.cpu-temp;
                    pct:       root.metrics.temp-pct;
                    warn-at:   0.75;
                    danger-at: 0.88;
                }
            }
            Row {
                MetricBarCard {
                    label:     "MEMORY";
                    value:     root.metrics.ram;
                    pct:       root.metrics.ram-pct;
                    warn-at:   0.75;
                    danger-at: 0.90;
                }
                MetricBarCard {
                    label:     "STORAGE";
                    value:     root.metrics.disk;
                    pct:       root.metrics.disk-pct;
                    warn-at:   0.80;
                    danger-at: 0.92;
                }
            }
        }
    }
}
