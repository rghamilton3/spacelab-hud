import { Theme, HudAlert } from "theme.slint";

component AlertRow {
    in property <HudAlert> alert;

    property <color> sev-color: root.alert.severity == "critical" ? Theme.danger
                               : (root.alert.severity == "warning" ? Theme.warn : Theme.accent);

    Rectangle {
        background: Theme.surface;
        border-radius: 6px;
        clip: true;

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: 3px;
                background: sev-color;
            }

            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                alignment: center;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.alert.name;
                        color: sev-color;
                        font-size: 16px;
                        font-family: "monospace";
                    }
                    Text {
                        text: root.alert.age;
                        color: Theme.text-dim;
                        font-size: 16px;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.alert.summary;
                    color: Theme.text-primary;
                    font-size: 16px;
                }
                Text {
                    text: root.alert.severity;
                    color: sev-color;
                    font-size: 16px;
                    letter-spacing: 2px;
                }
            }
        }
    }
}

export component AlertsScreen {
    in property <[HudAlert]> alerts;
    in property <int>        alert-count;
    in property <int>        alert-worst-severity;
    in property <bool>       alerts-reachable: true;
    in property <bool>       show-back:        false;
    in property <bool>       show-forward:     false;

    property <int> level:
        !alerts-reachable ? 2
        : (alert-count == 0 ? 0 : alert-worst-severity);
    property <color> status-color:
        level == 2 ? Theme.danger : (level == 1 ? Theme.warn : Theme.accent);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // ── Header ──────────────────────────────────────────────────
        Rectangle {
            height: 84px;
            background: Theme.surface;

            HorizontalLayout {
                padding-left: 21px;
                padding-right: 21px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "‹";
                        color: Theme.text-label;
                        font-size: 42px;
                        vertical-alignment: center;
                        opacity: root.show-back ? 0.8 : 0.0;
                        animate opacity { duration: 200ms; }
                    }
                    HorizontalLayout {
                        spacing: 0px;
                        Text {
                            text: "SPACELAB-1 // ALERTS";
                            color: status-color;
                            font-size: 22px;
                            letter-spacing: 3px;
                            vertical-alignment: center;
                            animate color { duration: 500ms; }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: !root.alerts-reachable ? "OFFLINE"
                            : root.alert-count + " ACTIVE";
                        color: !root.alerts-reachable ? Theme.danger
                             : (root.alert-count == 0 ? Theme.accent : Theme.danger);
                        font-size: 24px;
                        letter-spacing: 3px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "›";
                        color: Theme.text-label;
                        font-size: 42px;
                        vertical-alignment: center;
                        opacity: root.show-forward ? 0.8 : 0.0;
                        animate opacity { duration: 200ms; }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // ── Alertmanager offline ─────────────────────────────────────
        if !root.alerts-reachable: Rectangle {
            VerticalLayout {
                alignment: center;
                spacing: 16px;

                Text {
                    text: "✕";
                    color: Theme.danger;
                    font-size: 48px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "ALERTMANAGER OFFLINE";
                    color: Theme.danger;
                    font-size: 18px;
                    letter-spacing: 3px;
                    horizontal-alignment: center;
                }
            }
        }

        // ── No alerts ────────────────────────────────────────────────
        if root.alerts-reachable && root.alert-count == 0: Rectangle {
            VerticalLayout {
                alignment: center;
                spacing: 16px;

                Text {
                    text: "✓";
                    color: Theme.accent;
                    font-size: 48px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "ALL SYSTEMS NOMINAL";
                    color: Theme.accent;
                    font-size: 18px;
                    letter-spacing: 3px;
                    horizontal-alignment: center;
                }
            }
        }

        // ── Active alerts ─────────────────────────────────────────────
        if root.alerts-reachable && root.alert-count > 0: VerticalLayout {
            padding: 10px;
            spacing: 7px;

            for alert in root.alerts: AlertRow { alert: alert; }
        }
    }
}
